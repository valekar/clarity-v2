#!/bin/sh
set -eu

service_user=_clarity-sync
service_group=_clarity-sync
if ! /usr/bin/dscl . -read "/Users/$service_user" >/dev/null 2>&1; then
  /usr/bin/printf '%s\n' 'Provision the dedicated _clarity-sync account before installing.' >&2
  exit 1
fi
if ! /usr/bin/dscl . -read "/Groups/$service_group" >/dev/null 2>&1; then
  /usr/bin/printf '%s\n' 'Provision the dedicated _clarity-sync group before installing.' >&2
  exit 1
fi
exit 0

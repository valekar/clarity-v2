FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e

RUN apt-get update \
  && apt-get install --yes --no-install-recommends postgresql-client \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chown=node:node libs/database/src/migrate.ts /app/src/migrate.ts
COPY --chown=node:node libs/database/migrations /app/migrations
COPY --chown=node:node deploy/cloud/postgres/grant-clarity-runtime.sql /app/grant-clarity-runtime.sql
COPY --chown=node:node deploy/cloud/scripts/run-clarity-migrations.sh /app/run-migrations.sh
USER node
ENTRYPOINT ["/bin/sh", "/app/run-migrations.sh"]

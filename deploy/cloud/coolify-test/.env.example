# Copy into Coolify's private environment settings. Replace every value.
# Values are synthetic test credentials only. Never reuse production or V1 secrets.
CLARITY_DOMAIN=clarity-test.example.com
HANKO_DOMAIN=auth-test.example.com
HANKO_COOKIE_DOMAIN=.example.com
CLARITY_PUBLIC_ORIGIN=https://clarity-test.example.com
HANKO_PUBLIC_API_URL=https://auth-test.example.com
HANKO_ISSUER=https://auth-test.example.com
HANKO_AUDIENCE=clarity-v2-coolify-test

# Generate unique random passwords for this test deployment.
PG_BOOTSTRAP_PASSWORD=replace-with-random-secret
CLARITY_MIGRATOR_PASSWORD=replace-with-random-secret
CLARITY_RUNTIME_PASSWORD=replace-with-random-secret
CLARITY_WORKER_PASSWORD=replace-with-random-secret
CLARITY_DEVICE_AUTH_PASSWORD=replace-with-random-secret
HANKO_MIGRATOR_PASSWORD=replace-with-random-secret
HANKO_RUNTIME_PASSWORD=replace-with-random-secret
HANKO_SECRET_ENCRYPTION_KEY=replace-with-64-hex-characters
ORTHANC_RUNTIME_PASSWORD=replace-with-random-secret
ORTHANC_HTTP_USERNAME=synthetic-test
ORTHANC_HTTP_PASSWORD=replace-with-random-secret

# Dedicated disposable S3-compatible test bucket. Allow only this bucket/prefix.
# The public endpoint must be reachable by a separate centre test machine for
# short-lived signed PUT URLs. Use the provider's matching internal endpoint if
# it offers one; otherwise set both endpoints to the public HTTPS endpoint.
INTAKE_S3_ENDPOINT=https://s3-test.example.net
INTAKE_S3_PUBLIC_ENDPOINT=https://s3-test.example.net
INTAKE_S3_BUCKET=clarity-v2-synthetic-test
INTAKE_S3_REGION=us-east-1
INTAKE_S3_WEB_ACCESS_KEY=replace-with-bucket-scoped-key
INTAKE_S3_WEB_SECRET_KEY=replace-with-random-secret
INTAKE_S3_WORKER_ACCESS_KEY=replace-with-bucket-scoped-key
INTAKE_S3_WORKER_SECRET_KEY=replace-with-random-secret

# Absolute persistent host directory. Run prepare.sh on the Coolify host first.
HANKO_CONFIG_DIR=/data/coolify/clarity-v2-synthetic-test/config

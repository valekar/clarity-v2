FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e AS build

RUN npm install --global pnpm@12.3.4
WORKDIR /workspace
COPY . .
ARG NEXT_PUBLIC_HANKO_API_URL
ENV NEXT_PUBLIC_HANKO_API_URL=${NEXT_PUBLIC_HANKO_API_URL}
RUN test -n "$NEXT_PUBLIC_HANKO_API_URL" \
  && pnpm install --frozen-lockfile \
  && pnpm --filter @clarity/web... build

FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e
ARG NEXT_PUBLIC_HANKO_API_URL
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NEXT_PUBLIC_HANKO_API_URL=${NEXT_PUBLIC_HANKO_API_URL}
WORKDIR /app
COPY --from=build --chown=node:node /workspace/apps/web/.next/standalone/ /app/
COPY --from=build --chown=node:node /workspace/apps/web/.next/static/ /app/apps/web/.next/static/
USER node
CMD ["node", "apps/web/server.js"]
